DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

DJANGO_DATABASE_ENGINE=postgres
POSTGRES_DB=dis_sys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://localhost:6379/0

DJANGO_API_PAGE_SIZE=100
DJANGO_THROTTLE_ANON=300/day
DJANGO_THROTTLE_USER=2000/day
DJANGO_THROTTLE_AUTH_LOGIN=20/minute
DJANGO_THROTTLE_AUTH_REGISTER=10/hour
DJANGO_THROTTLE_EMAIL_VERIFY=20/hour
DJANGO_THROTTLE_EMAIL_RESEND=5/hour
DJANGO_AUDIT_LOG_ENABLED=True

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
